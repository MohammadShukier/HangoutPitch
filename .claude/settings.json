{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git init:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(npx expo start:*)",
      "Bash(npm start:*)",
      "Bash(npm run start:*)",
      "Read(./node_modules/**)",
      "Read(./.expo/**)"
    ]
  }
}